#pragma once

// Generated from .env or default. String literal.
#define DEFAULT_SSID_PREFIX_TEMPLATE "@DEFAULT_PREFIX@"

// Default authentication mode (WPA2_PSK, WPA3_PSK, or WPA3-SAE)
#define DEFAULT_AUTH_MODE "@DEFAULT_AUTH_MODE@"

// Default country code (ISO 3166-1 alpha-2, e.g., "US", "JP", "DE")
#define DEFAULT_COUNTRY_CODE "@DEFAULT_COUNTRY_CODE@"

// Default WPS device name template (use 'XXXX' for MAC address suffix)
#define DEFAULT_WPS_DEVICE_NAME "@DEFAULT_WPS_DEVICE_NAME@"

// Default Alcatel-Lucent AP Name IE value template (use 'XXXX' for MAC address suffix)
#define DEFAULT_APNAME_IE_VALUE "@DEFAULT_APNAME_IE_VALUE@"

// Default WPS enabled flag (true or false)
#define DEFAULT_WPS_ENABLED "@DEFAULT_WPS_ENABLED@"

// Default Alcatel-Lucent AP Name IE enabled flag (true or false)
#define DEFAULT_APNAME_IE_ENABLED "@DEFAULT_APNAME_IE_ENABLED@"

// Default password/PSK (8-63 chars for WPA, empty for open network)
#define DEFAULT_PASSWORD "@DEFAULT_PASSWORD@"
