# Default SSID prefix template. Use 'XXXX' where the last 4 hex digits of the MAC should be inserted.
DEFAULT_SSID_PREFIX_TEMPLATE="ESP32-XXXX"

# Default authentication mode for softAP
# Options: WPA2_PSK, WPA3_PSK (also accepts WPA3-SAE)
# Note: WPA3 requires CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT to be enabled in sdkconfig
DEFAULT_AUTH_MODE="WPA2_PSK"